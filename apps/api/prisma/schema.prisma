generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  CASHIER
  WAREHOUSE
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  phone          String?
  role           Role            @default(CASHIER)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  orders         Order[]
  purchases      Purchase[]
  cashShifts     CashShift[]
  saleReturns    SaleReturn[]
  purchaseReturns PurchaseReturn[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id             Int             @id @default(autoincrement())
  sku            String          @unique
  barcode        String?
  name           String
  description    String?
  categoryId     Int
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUnit       String          // Satuan terkecil, misal: PCS, KG, LITER, BTL
  currentStock   Decimal         @default(0) @db.Decimal(12, 2) // Stok dalam satuan dasar
  minStock       Decimal         @default(10) @db.Decimal(12, 2) // Batas peringatan stok menipis
  purchasePrice  Decimal         @default(0) @db.Decimal(15, 2) // HPP / Harga beli satuan dasar
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  units          ProductUnit[]
  stockMovements      StockMovement[]
  orderItems          OrderItem[]
  purchaseItems       PurchaseItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@index([categoryId])
  @@index([name])
  @@index([barcode])
  @@map("products")
}

model ProductUnit {
  id               Int         @id @default(autoincrement())
  productId        Int
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitName         String   // misal: PCS, PACK, DUS, RENCENG, SAK, KARTON
  conversionFactor Decimal  @default(1) @db.Decimal(10, 2) // Faktor pengali ke satuan dasar (misal 1 DUS = 24 PCS -> 24)
  isBaseUnit       Boolean  @default(false)
  price            Decimal  @default(0) @db.Decimal(15, 2) // Harga jual eceran / standar
  wholesalePrice   Decimal? @db.Decimal(15, 2) // Harga jual grosir / partai
  barcode          String?  // Barcode khusus satuan ini (misal barcode dus berbeda dg barcode satuan)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orderItems       OrderItem[]
  purchaseItems    PurchaseItem[]

  @@unique([productId, unitName])
  @@index([productId])
  @@map("product_units")
}

model StockMovement {
  id            Int          @id @default(autoincrement())
  productId     Int
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 2) // Jumlah perubahan dalam satuan dasar
  previousStock Decimal      @db.Decimal(12, 2) // Stok sebelum perubahan
  currentStock  Decimal      @db.Decimal(12, 2) // Stok setelah perubahan
  referenceType String?      // INITIAL, PURCHASE, SALE, ADJUSTMENT, RETURN
  referenceId   String?      // No faktur / referensi
  note          String?      // Keterangan audit trail
  userId        Int?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("stock_movements")
}

model Customer {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  phone       String?
  address     String?
  tier        String   @default("REGULAR") // REGULAR, GROSIR, VIP
  creditLimit Decimal  @default(0) @db.Decimal(15, 2) // Batas plafon piutang bon tempo
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@map("customers")
}

model Supplier {
  id            Int        @id @default(autoincrement())
  code          String     @unique
  name          String
  contactPerson String?
  phone         String?
  address       String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]

  @@map("suppliers")
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  TEMPO
}

enum OrderStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum OrderPaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

model Order {
  id             Int                @id @default(autoincrement())
  invoiceNumber  String             @unique // Nomor faktur unik: INV-20261019-0001
  userId         Int
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerId     Int?
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal       Decimal            @db.Decimal(15, 2)
  discountAmount Decimal            @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal            @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal            @db.Decimal(15, 2)
  paymentMethod  PaymentMethod      @default(CASH)
  paymentStatus  OrderPaymentStatus @default(PAID)
  dueDate        DateTime?          // Tanggal jatuh tempo jika TEMPO
  amountPaid     Decimal            @db.Decimal(15, 2)
  changeAmount   Decimal            @default(0) @db.Decimal(15, 2)
  status         OrderStatus        @default(COMPLETED)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          OrderItem[]
  payments       OrderPayment[]
  cashShiftId    Int?
  cashShift      CashShift?         @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  saleReturns    SaleReturn[]

  @@index([userId])
  @@index([customerId])
  @@index([cashShiftId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderPayment {
  id            Int           @id @default(autoincrement())
  orderId       Int
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        Int
  amount        Decimal       @db.Decimal(15, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  note          String?
  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@map("order_payments")
}

model OrderItem {
  id               Int          @id @default(autoincrement())
  orderId          Int
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productUnitId    Int?
  productUnit      ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: SetNull)
  productName      String       // Snapshot nama produk
  sku              String       // Snapshot SKU
  unitName         String       // Snapshot nama satuan (misal: "DUS (24 PCS)")
  conversionFactor Decimal      @db.Decimal(10, 2) // Snapshot pengali saat transaksi
  quantity         Decimal      @db.Decimal(12, 2) // Kuantitas satuan yang dibeli
  baseQuantity     Decimal      @db.Decimal(12, 2) // Kuantitas dalam satuan dasar (quantity * conversionFactor)
  costPrice        Decimal      @db.Decimal(15, 2) // HPP saat transaksi
  unitPrice        Decimal      @db.Decimal(15, 2) // Harga per satuan
  subtotal         Decimal      @db.Decimal(15, 2) // quantity * unitPrice
  discountAmount   Decimal      @default(0) @db.Decimal(15, 2)
  totalAmount      Decimal      @db.Decimal(15, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum PurchasePaymentType {
  CASH
  TEMPO
}

enum PurchasePaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PurchaseStatus {
  RECEIVED
  CANCELLED
}

model Purchase {
  id                Int                   @id @default(autoincrement())
  purchaseNumber    String                @unique // PB-YYYYMMDD-XXXX
  supplierInvoiceNo String?               // No faktur / surat jalan dari supplier
  supplierId        Int
  supplier          Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  userId            Int
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchaseDate      DateTime              @default(now())
  paymentType       PurchasePaymentType   @default(CASH)
  paymentStatus     PurchasePaymentStatus @default(PAID)
  dueDate           DateTime?             // Jatuh tempo jika TEMPO
  subtotal          Decimal               @db.Decimal(15, 2)
  taxAmount         Decimal               @default(0) @db.Decimal(15, 2)
  discountAmount    Decimal               @default(0) @db.Decimal(15, 2)
  totalAmount       Decimal               @db.Decimal(15, 2)
  amountPaid        Decimal               @default(0) @db.Decimal(15, 2)
  status            PurchaseStatus        @default(RECEIVED)
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             PurchaseItem[]
  payments          PurchasePayment[]
  purchaseReturns   PurchaseReturn[]

  @@index([supplierId])
  @@index([userId])
  @@index([purchaseDate])
  @@index([paymentStatus])
  @@map("purchases")
}

model PurchaseItem {
  id               Int          @id @default(autoincrement())
  purchaseId       Int
  purchase         Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productUnitId    Int?
  productUnit      ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: SetNull)
  productName      String       // Snapshot nama produk
  sku              String       // Snapshot SKU
  unitName         String       // Snapshot nama satuan (misal: "DUS (40 BKS)")
  conversionFactor Decimal      @db.Decimal(10, 2) // Pengali ke satuan dasar saat beli
  quantity         Decimal      @db.Decimal(12, 2) // Kuantitas unit yang dibeli (misal: 10 DUS)
  baseQuantity     Decimal      @db.Decimal(12, 2) // Total dalam satuan dasar (quantity * conversionFactor)
  unitCost         Decimal      @db.Decimal(15, 2) // Harga beli per unit (misal: 115.000 / DUS)
  baseCost         Decimal      @db.Decimal(15, 2) // HPP per satuan dasar (misal: 2.875 / BKS)
  subtotal         Decimal      @db.Decimal(15, 2) // quantity * unitCost
  createdAt        DateTime     @default(now())

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model PurchasePayment {
  id            Int           @id @default(autoincrement())
  purchaseId    Int
  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  userId        Int
  amount        Decimal       @db.Decimal(15, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  note          String?
  createdAt     DateTime      @default(now())

  @@index([purchaseId])
  @@map("purchase_payments")
}

model CashShift {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  startTime    DateTime  @default(now())
  endTime      DateTime?
  startingCash Decimal   @db.Decimal(15, 2)
  expectedCash Decimal?  @db.Decimal(15, 2)
  closingCash  Decimal?  @db.Decimal(15, 2)
  difference   Decimal?  @db.Decimal(15, 2)
  status       String    @default("OPEN") // OPEN, CLOSED
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]

  @@index([userId])
  @@index([status])
  @@map("cash_shifts")
}

model SaleReturn {
  id           Int              @id @default(autoincrement())
  returnNumber String           @unique // RET-J-YYYYMMDD-XXXX
  orderId      Int
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId       Int
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  reason       String
  refundMethod String           @default("CASH") // CASH, CREDIT_OFFSET, NO_REFUND
  totalAmount  Decimal          @db.Decimal(15, 2)
  createdAt    DateTime         @default(now())
  items        SaleReturnItem[]

  @@index([orderId])
  @@index([userId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id               Int        @id @default(autoincrement())
  saleReturnId     Int
  saleReturn       SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitName         String
  conversionFactor Decimal    @db.Decimal(10, 2)
  quantity         Decimal    @db.Decimal(12, 2)
  baseQuantity     Decimal    @db.Decimal(12, 2)
  price            Decimal    @db.Decimal(15, 2)
  subtotal         Decimal    @db.Decimal(15, 2)
  returnToStock    Boolean    @default(true) // Jika true, stok bertambah lagi

  @@index([saleReturnId])
  @@index([productId])
  @@map("sale_return_items")
}

model PurchaseReturn {
  id           Int                  @id @default(autoincrement())
  returnNumber String               @unique // RET-B-YYYYMMDD-XXXX
  purchaseId   Int
  purchase     Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  supplierId   Int
  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  userId       Int
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  reason       String
  refundMethod String               @default("DEBT_OFFSET") // CASH, DEBT_OFFSET
  totalAmount  Decimal              @db.Decimal(15, 2)
  createdAt    DateTime             @default(now())
  items        PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([supplierId])
  @@index([userId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitName         String
  conversionFactor Decimal        @db.Decimal(10, 2)
  quantity         Decimal        @db.Decimal(12, 2)
  baseQuantity     Decimal        @db.Decimal(12, 2)
  cost             Decimal        @db.Decimal(15, 2)
  subtotal         Decimal        @db.Decimal(15, 2)

  @@index([purchaseReturnId])
  @@index([productId])
  @@map("purchase_return_items")
}

model StoreSetting {
  id            Int      @id @default(1)
  storeName     String   @default("GrosirPOS Sembako")
  tagline       String?  @default("Pusat Grosir & Eceran Sembako Murah")
  address       String?  @default("Jl. Raya Pasar Induk No. 88, Jakarta")
  phone         String?  @default("0812-3456-7890")
  footerReceipt String?  @db.Text
  paperSize     String   @default("58mm") // 58mm, 80mm
  updatedAt     DateTime @updatedAt

  @@map("store_settings")
}



